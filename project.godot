; Engine configuration file.
config_version=5

[application]

config/name="Bonecrawl"
config/description="Crawl the crypt, choose your doors, break the Bone King."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://ui/icon.png"
boot_splash/bg_color=Color(0.03, 0.025, 0.05, 1)
boot_splash/image="res://ui/splash.png"
boot_splash/stretch_mode=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2

[autoload]

Game="*res://scripts/autoload/game.gd"
Models="*res://scripts/autoload/models.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Fx="*res://scripts/autoload/fx.gd"

[physics]

common/physics_ticks_per_second=60
